  <script>
    var activeRole = 'citizen';
    var roleEmails = {
      citizen: 'budi.santoso@warga.id',
      admin: 'admin@fastrack.go.id',
      tech: 'andi.teknisi@fastrack.go.id'
    };
    var roleTargets = {
      citizen: '../04-citizen-home/CitizenHome.html',
      admin: '../09-admin-home/AdminHome.html',
      tech: '../14-tech-home/TechnicianHome.html'
    };

    function selectRole(role) {
      activeRole = role;
      document.getElementById('email-input').value = roleEmails[role];
      var btns = document.querySelectorAll('.role-btn');
      btns.forEach(function (b) {
        b.className = 'role-btn min-h-[40px] rounded-md border border-outline bg-surface text-on-surface-variant text-label-md font-label';
      });
      var selected = document.getElementById('role-' + role);
      selected.className = 'role-btn min-h-[40px] rounded-md border border-primary bg-light-blue text-on-light-blue text-label-md font-label';
    }

    function togglePassword() {
      var input = document.getElementById('password-input');
      var icon = document.getElementById('eye-icon');
      if (input.type === 'password') {
        input.type = 'text';
        icon.textContent = 'visibility_off';
      } else {
        input.type = 'password';
        icon.textContent = 'visibility';
      }
    }

    function showResetNotice() {
      document.getElementById('reset-notice').classList.remove('hidden');
    }

    function handleLogin(e) {
      e.preventDefault();
      var email = document.getElementById('email-input').value.toLowerCase();
      var target = roleTargets[activeRole];
      if (email.includes('admin')) target = roleTargets.admin;
      else if (email.includes('teknisi') || email.includes('petugas')) target = roleTargets.tech;
      try {
        localStorage.setItem('fastrack_role', activeRole);
      } catch (err) {}
      window.location.href = target;
    }
  </script>


